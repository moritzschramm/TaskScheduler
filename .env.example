# ---------------------------------------------------------------------------
# Ambitime environment. Copy to `.env` and adjust.
# `docker compose` reads this file automatically.
# ---------------------------------------------------------------------------

# Postgres
POSTGRES_USER=ambitime
POSTGRES_PASSWORD=ambitime
POSTGRES_DB=ambitime
POSTGRES_PORT=5432

# Connection string used by the server. Inside compose the host is the
# `postgres` service; running the server on the host, use localhost.
DATABASE_URL=postgres://ambitime:ambitime@postgres:5432/ambitime

# Server
SERVER_PORT=3000
NODE_ENV=development

# nginx (the only port you need on the host in dev)
HTTP_PORT=8080
