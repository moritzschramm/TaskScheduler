# ---------------------------------------------------------------------------
# Ambitime environment. Copy to `.env` and adjust.
# `docker compose` reads this file automatically.
# ---------------------------------------------------------------------------

# Postgres
POSTGRES_USER=ambitime
POSTGRES_PASSWORD=ambitime
POSTGRES_DB=ambitime
POSTGRES_PORT=5432

# Host-side connection string, used when running the server, migrations or
# tests directly on your machine. Inside compose the server service sets its own
# DATABASE_URL (host `postgres`), and a real environment variable always wins
# over this file.
DATABASE_URL=postgres://ambitime:ambitime@localhost:5432/ambitime

# Server
SERVER_PORT=3000
NODE_ENV=development

# nginx (the only port you need on the host in dev)
HTTP_PORT=8080
