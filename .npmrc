# Workspace packages are consumed from source (see each package's "exports"),
# so peer resolution should not fail the install on transitive mismatches.
strict-peer-dependencies=false

# pnpm re-checks node_modules against the lockfile before running a script. When
# a dependency has been added since a container's node_modules volume was
# created, it wants to purge and reinstall — and aborts instead, because there
# is no TTY to confirm at. That is the whole of
# ERR_PNPM_ABORTED_REMOVE_MODULES_DIR_NO_TTY, and it took the dev stack down
# every time the lockfile moved.
#
# Set here rather than as `CI=true` in compose: `CI` also switches installs to
# frozen-lockfile and changes reporter output, which is a lot of behaviour to
# buy for one confirmation prompt.
confirm-modules-purge=false
