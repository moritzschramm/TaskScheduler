{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "preserve",
    "types": ["vite/client"],
    // No `baseUrl`: deprecated in TS 6. `paths` resolves relative to this file.
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.vue", "test/**/*.ts", "env.d.ts"],
  // The smoke test imports the server's runtime and needs Node types; it has
  // its own project so the browser build never acquires them.
  "exclude": ["test/e2e-smoke.test.ts"]
}
