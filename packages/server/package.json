{
  "name": "@ambitime/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/app.ts",
    "./auth": "./src/auth/index.ts",
    "./db": "./src/db/client.ts",
    "./email": "./src/notifications/email.ts",
    "./migrate": "./src/db/migrate.ts",
    "./schema": "./src/db/schema/index.ts",
    "./testing": "./test/support/database.ts"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "build": "node build.js",
    "start": "node --env-file-if-exists=../../.env dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=../../.env src/db/migrate.ts",
    "check:imports": "tsx scripts/check-imports.ts"
  },
  "dependencies": {
    "@ambitime/scheduler": "workspace:*",
    "@ambitime/shared": "workspace:*",
    "@anthropic-ai/sdk": "^0.125.0",
    "@better-auth/sso": "^1.7.2",
    "@hono/node-server": "^2.1.1",
    "@hono/zod-validator": "^0.9.0",
    "better-auth": "^1.7.2",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.5",
    "openai": "^7.15.0",
    "pg-boss": "^12.28.1",
    "postgres": "^3.4.9",
    "rrule": "^2.8.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.28.0",
    "tsx": "^4.23.12",
    "typescript": "~6.0.3",
    "vitest": "^4.1.11"
  }
}
